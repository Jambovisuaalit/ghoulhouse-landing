# Canonical is intentionally pinned to https://ghoulhouse.fi in src/config/site.ts.
# Do not make it environment-dependent: a stale Vercel value can invert routing.

# Lead delivery. Choose one mode: webhook | resend
LEAD_DELIVERY_MODE=

# Generic HTTPS webhook mode
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Resend mode
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Legal routes. Keep empty until approved documents exist.
# Example: /tietosuoja
NEXT_PUBLIC_PRIVACY_PATH=
NEXT_PUBLIC_TERMS_PATH=

# Plausible Analytics.
# Add ghoulhouse.fi as a site in Plausible and paste the exact site-specific
# script URL from Plausible Settings -> General -> Site installation.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Content Security Policy rollout.
# Default/unset = Report-Only. Set true only after Preview QA shows no required violations.
CSP_ENFORCE=false

# SEO launch gate.
# Keep false/unset in local and Preview environments.
# Set true only in Vercel Production after:
# - final QA
# - ghoulhouse.fi domain validation
# - approved privacy path is configured
SITE_INDEXABLE=false

# Optional verified founder portrait. Use a local public asset path, e.g. /hanna-founder.jpg
NEXT_PUBLIC_FOUNDER_IMAGE=
