# Canonical is intentionally pinned to https://ghoulhouse.fi in src/config/site.ts.
# Do not make it environment-dependent: a stale Vercel value can invert routing.

# Lead storage.
# GhoulHouse stores validated leads through a restricted Supabase RPC.
# The publishable key is low-privilege and protected by database access controls.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Lead notification email is handled by a Supabase database trigger.
# The restricted Resend sending key is stored in Supabase Vault under:
# ghoulhouse_resend_api_key

# Legal routes.
NEXT_PUBLIC_PRIVACY_PATH=/tietosuoja
NEXT_PUBLIC_TERMS_PATH=

# Google Analytics 4.
# Public Measurement ID G-43VQ8505YL is intentionally pinned in
# src/components/analytics/GoogleAnalytics.tsx for traceable release configuration.

# Content Security Policy rollout.
# Default/unset = Report-Only. Set true only after Production QA shows no required violations.
CSP_ENFORCE=false

# SEO launch gate.
# Keep false/unset in local and Preview environments.
# Set true only in Vercel Production after final QA and lead-flow verification.
SITE_INDEXABLE=false

# Optional verified founder portrait. Use a local public asset path, e.g. /hanna-founder.jpg
NEXT_PUBLIC_FOUNDER_IMAGE=
